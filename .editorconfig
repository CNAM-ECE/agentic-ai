root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.ipynb]
indent_size = 1
insert_final_newline = false

[*.{yml,yaml,toml}]
indent_size = 2

[Dockerfile]
indent_size = 4

[Makefile]
indent_style = tab
